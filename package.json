{
    "name":  "asptbackend",
    "version":  "0.1.0",
    "private":  true,
    "description":  "TypeScript AWS Lambda handlers generated from openapi.yaml",
    "main":  "dist/index.js",
    "scripts":  {
                    "build":  "tsc -p tsconfig.json",
                    "typecheck":  "tsc --noEmit -p tsconfig.json",
                    "dev:local":  "tsx src/local/express.ts",
                    "start:local":  "npm run build \u0026\u0026 node dist/local/express.js",
                    "db:setup:local":  "node scripts/setup-local-dynamodb.js",
                    "smoke:local":  "node scripts/smoke-test.js"
                },
    "dependencies":  {
                         "@aws-sdk/client-dynamodb":  "^3.1009.0",
                         "@aws-sdk/lib-dynamodb":  "^3.1009.0",
                         "dotenv":  "^17.3.1",
                         "express":  "^4.21.2",
                         "swagger-ui-express":  "^5.0.1",
                         "yamljs":  "^0.3.0"
                     },
    "devDependencies":  {
                            "@types/aws-lambda":  "^8.10.156",
                            "@types/express":  "^4.17.23",
                            "@types/swagger-ui-express":  "^4.1.8",
                            "@types/yamljs":  "^0.2.34",
                            "tsx":  "^4.20.5",
                            "typescript":  "^5.9.2"
                        }
}
